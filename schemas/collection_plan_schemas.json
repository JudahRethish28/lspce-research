{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "CollectionPlan",
  "type": "object",
  "required": ["warrant_id","proposed_resources"],
  "properties": {
    "warrant_id": {"type": "string"},
    "proposed_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource_type","source_name",
                     "tenant_id","time_window"],
        "properties": {
          "resource_type": {"type": "string"},
          "source_name":   {"type": "string"},
          "tenant_id":     {"type": "string"},
          "time_window": {
            "type": "object",
            "properties": {
              "start": {"type": "string"},
              "end":   {"type": "string"}
            }
          }
        }
      }
    }
  }
}